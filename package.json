{
  "name": "mern-ecommerce-backend",
  "version": "1.0.0",
  "description": "MERN Stack E-Commerce Application Backend & Dev Runner",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "build": "cd client && npm install && npm run build",
    "dev": "nodemon server.js",
    "client": "npm run dev --prefix client",
    "dev:full": "concurrently \"npm run dev\" \"npm run client\"",
    "seed": "node -e \"require('./seedData')\"",
    "test": "jest"
  },
  "dependencies": {
    "express": "^4.18.2",
    "mongoose": "^7.5.0",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "multer": "^1.4.4",
    "stripe": "^13.3.0",
    "nodemailer": "^6.9.4",
    "mongodb-memory-server": "^8.15.1"
  },
  "devDependencies": {
    "nodemon": "^3.0.1",
    "jest": "^29.6.2",
    "concurrently": "^8.2.1"
  },
  "author": "MERN E-Commerce",
  "license": "MIT"
}
